# ─────────────────────────────────────────────────────────────
# Aria — AI companion app configuration
# Copy to .env and fill in. Everything is optional: with nothing set,
# the app runs fully in dev mode (in-memory data, sandbox payments,
# scripted AI replies).
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
# Public base URL (used to build Stripe redirect links in production)
# PUBLIC_URL=https://your-domain.com

# Session signing secret — SET A STABLE VALUE IN PRODUCTION.
# (When unset, an ephemeral secret is generated and sessions reset on restart.)
# JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30

# The companion character
CHARACTER_NAME=Aria

# ── AI (Anthropic Claude) ──
# Without a key, the app uses friendly scripted replies.
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-8

# ── Credits & subscription ──
SIGNUP_BONUS_CREDITS=20
# Optionally pre-create a Stripe recurring Price and reference it here:
# STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# ── Database (Postgres) ──
# Without it, data is in-memory and resets on restart.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=true

# ── Stripe payments ──
# Without STRIPE_SECRET_KEY, payments run in sandbox mode (no real charges).
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_PUBLISHABLE_KEY=pk_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen` / dashboard
#   Webhook endpoint to configure in Stripe:  POST /api/stripe/webhook

# ── Admin ──
# The account registered with this email is granted admin rights.
# ADMIN_EMAIL=you@example.com
