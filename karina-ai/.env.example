# =============================================================================
# KARINA AI — Environment configuration (Phase 1 foundation)
#
# Copy to `.env.local` and fill in as each capability is switched on.
# Every key below is a documented integration SEAM. None are wired up in
# Phase 1 — they describe where future services plug in.
# =============================================================================

# --- Core -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Phase 2+) ----------------------------------------------------
# PostgreSQL connection string used by Prisma (see prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/karina_ai?schema=public"

# --- AI: Chat / reasoning (Phase 3) -----------------------------------------
# KARINA's conversational brain. Anthropic Claude is the default provider.
ANTHROPIC_API_KEY=""
KARINA_MODEL="claude-sonnet-5"

# --- AI: Voice conversation (Phase 4) ---------------------------------------
# Speech-to-text + text-to-speech providers for spoken conversations.
VOICE_STT_API_KEY=""
VOICE_TTS_API_KEY=""
VOICE_TTS_VOICE_ID=""

# --- AI: Video avatar (Phase 4) ---------------------------------------------
# Real-time avatar rendering / streaming provider for KARINA's video presence.
AVATAR_PROVIDER_API_KEY=""
AVATAR_STREAM_URL=""

# --- Authentication & accounts (Phase 5) ------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Payments & memberships (Phase 6) ---------------------------------------
PAYMENTS_PUBLIC_KEY=""
PAYMENTS_SECRET_KEY=""
PAYMENTS_WEBHOOK_SECRET=""

# --- Knowledge base / vector search (Phase 3) -------------------------------
VECTOR_DB_URL=""
VECTOR_DB_API_KEY=""

# --- Analytics (Phase 7) ----------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=""

# --- CRM (Phase 7) ----------------------------------------------------------
CRM_API_KEY=""
CRM_BASE_URL=""
