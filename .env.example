# ==============================
# ROETO API (ראוטרו) – OAuth2
# ==============================
ROETO_API_URL=https://api.roeto.co.il

# OAuth2 Client Credentials (from Roeto API settings page)
ROETO_CLIENT_ID=73cc0f72-4bc1-430a-8152-e390880601c4
ROETO_CLIENT_SECRET=your_new_client_secret_here

# Token endpoint path (default: /oauth/token)
ROETO_TOKEN_PATH=/oauth/token

# Path template to fetch a client by ID (use {id} as placeholder)
# Default: /api/clients/{id}  — confirm exact path with Roeto support
ROETO_CLIENT_PATH=/api/clients/{id}

# JSON field names returned by your Roeto API
ROETO_PHONE_FIELD=phone
ROETO_NAME_FIELD=name

# ==============================
# TWILIO SMS
# ==============================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+972XXXXXXXXX

# ==============================
# OTP SETTINGS
# ==============================
# How long OTP codes are valid (in minutes, default: 10)
OTP_EXPIRY_MINUTES=10

# ==============================
# DEVELOPMENT / TEST MODE
# ==============================
# When ROETO_API_URL is not set, OTP is printed to the server console.
# This phone number is used as the test phone in dev mode:
DEV_TEST_PHONE=0501234567

# ==============================
# MIA – AI CUSTOMER SERVICE AGENT
# ==============================
# Mia runs without any of these too (rule-based Hebrew fallback +
# in-memory conversation history). Chat page: /mia.html

# Anthropic API key – enables Claude-powered replies.
ANTHROPIC_API_KEY=

# Model that powers Mia (default: claude-opus-4-8).
# For cheaper/faster replies use: claude-haiku-4-5
MIA_MODEL=claude-opus-4-8

# Business name Mia represents (appears in her system prompt).
MIA_BUSINESS=קרין קרן - סוכנות לביטוח ופיננסים

# ==============================
# MIA – DATABASE (optional)
# ==============================
# Postgres connection string. When set, Mia's conversation history persists
# across restarts and instances. When unset, history is kept in memory.
DATABASE_URL=
# Set to true (or include sslmode=require in the URL) for managed Postgres.
PGSSL=

# ==============================
# MIA – WHATSAPP CLOUD API (optional)
# ==============================
# A string you choose; must match the "Verify token" in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Graph API access token for sending messages.
WHATSAPP_TOKEN=
# The sending phone number's ID (from the WhatsApp > API Setup page).
WHATSAPP_PHONE_NUMBER_ID=
# Optional: enables inbound X-Hub-Signature-256 verification.
WHATSAPP_APP_SECRET=
# Optional: Graph API version (default v21.0).
WHATSAPP_API_VERSION=v21.0

# ==============================
# MIA – VOICE MESSAGES (optional)
# ==============================
# Claude has no audio input, so WhatsApp voice notes are transcribed with
# OpenAI's audio transcription API before Mia answers. Without OPENAI_API_KEY
# Mia politely asks the customer to type instead.
OPENAI_API_KEY=
# Transcription model (default: gpt-4o-transcribe; whisper-1 also works).
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Language hint (ISO-639-1). Keep "he" – without it Hebrew comes back fragmentary.
TRANSCRIBE_LANGUAGE=he
# Optional vocabulary hint (names, products, terms) to steer spelling. When unset,
# a built-in list of pension/insurance terms in Hebrew is used.
TRANSCRIBE_PROMPT=

# ==============================
# SERVER
# ==============================
PORT=3000
